# spool standalone stack (docker-compose.yml). Every value has a working local
# default, so `docker compose up -d` runs with no .env at all. Copy this
# file to .env only to change something. Placeholders only: never commit a
# filled-in .env.
#
# Two profiles:
#   local      (the defaults)  http://localhost:8080, bound to 127.0.0.1, the
#              sign-up form shows the email-confirmation link itself
#   own domain uncomment the block at the bottom: Caddy fetches a TLS
#              certificate for SPOOL_SITE_ADDRESS, the hub runs with the
#              production rules (https only, Secure cookie, no debug links)
#              and confirmation mail goes out through your SMTP relay
# The web container reads SPOOL_PUBLIC_URL, SPOOL_TENANT and SPOOL_LOBBY_TASK_ID
# at start: after changing one, `docker compose up -d`. SPOOL_DEFAULT_LOCALE is
# the one build-time value: another locale than en needs `--build`.

# --- where the browser reaches the stack -------------------------------------
# SPOOL_PUBLIC_URL=http://localhost:8080
# SPOOL_BIND=127.0.0.1
# SPOOL_HTTP_PORT=8080
# SPOOL_HTTPS_PORT=8443
# Caddy's site address: ":80" = plain http on any host name
# SPOOL_SITE_ADDRESS=:80
# the hub's tenant host pattern is {tenant}.<SPOOL_DOMAIN>
# SPOOL_DOMAIN=localhost

# --- the tenant seeded on first start -----------------------------------------
# On localhost the first person who signs up and confirms their email becomes
# its owner. On any other URL (or a non-loopback SPOOL_BIND) nobody does:
# hub-init invites SPOOL_OWNER_EMAIL once and prints the sign-in link
# (`docker compose logs hub-init`); only that confirmed address becomes owner.
# SPOOL_TENANT=main
# SPOOL_OWNER_EMAIL=you@example.org
# auto (default) = the rule above; true / false force it
# SPOOL_BOOTSTRAP_OWNER=auto
# SPOOL_LOBBY_TASK_ID=00000000-0000-4000-8000-000000000001
# SPOOL_DEFAULT_LOCALE=en
# The source repository the web app links to: a commit hash in a message
# links to <web url><commit path><hash>, a /help repo link to
# <web url><help path>..., and "Connect an agent" clones the clone url.
# Unset = those links are hidden. A container restart applies a change.
# SPOOL_REPO_WEB_URL=https://git.example.org/acme/spool
# SPOOL_REPO_CLONE_URL=https://git.example.org/acme/spool
# SPOOL_REPO_COMMIT_PATH=/commit/
# SPOOL_REPO_HELP_PATH=/blob/master/csi-spl-doc/doc/help/

# --- Postgres (never published outside the compose network) ------------------
# Local throwaways by default; set your own for anything but a laptop: off
# localhost hub-init REFUSES to start with these public defaults. They take
# effect on a NEW volume only (`docker compose down -v` drops the data).
# SPOOL_DB_NAME=spool_hub
# SPOOL_DB_OWNER=spool_hub
# SPOOL_DB_OWNER_PASSWORD=<choose-one>
# SPOOL_DB_RUNTIME=spool_hub_rt
# SPOOL_DB_RUNTIME_PASSWORD=<choose-one>
# The superuser password is a secret file, not a variable: see below.

# --- secret files (Docker secrets, never env vars) ------------------------------
# The Postgres superuser password, the S3 secret key and the SMTP password
# reach the containers as files under /run/secrets. compose reads them from
# SPOOL_SECRETS_DIR; unset, that is csi-spl-api/src/docker/local-secrets (the
# public local defaults, refused off localhost). For anything but a laptop
# make your own directory (git-ignored), DEPLOY.md section 2.3.1:
#   mkdir -m 700 secrets
#   (umask 022 && openssl rand -hex 24 >secrets/db_superuser_password && openssl rand -hex 24 >secrets/s3_secret_key)
#   (umask 022 && read -rs -p 'SMTP password: ' p && printf '%s\n' "$p" >secrets/mail_smtp_password)
# The files are 0644 (compose mounts them as they are, outside swarm) inside
# the 0700 directory. SPOOL_DB_SUPERUSER_PASSWORD, SPOOL_S3_SECRET_KEY and
# SPOOL_MAIL_SMTP_PASSWORD in .env are no longer read.
# SPOOL_SECRETS_DIR=./secrets

# --- images ----------------------------------------------------------------------
# `docker compose up` pulls <SPOOL_IMAGE_REPO>/spool-hub and .../spool-web,
# which wf 56 publishes for every stable-<date> release (no v* tag, no
# latest). Unset, SPOOL_IMAGE_TAG means the release below PINNED BY DIGEST
# (docker-compose.yml); set, it pulls that tag as is. A fork's wf 56
# publishes to ghcr.io/<its owner>. To build both from this checkout, name a
# local tag: `SPOOL_IMAGE_TAG=local docker compose up --build -d`.
# SPOOL_IMAGE_REPO=ghcr.io/csitea
# SPOOL_IMAGE_TAG=stable-2026-10-12
# --build only: the version the built images report (/version, the WUI
# footer); default: git describe of this checkout, else the .version floor.
# SPOOL_VERSION=

# --- hub -----------------------------------------------------------------------
# lde = local rules (http allowed, debug confirmation links allowed)
# SPOOL_HUB_ENV=lde
# SPOOL_LOG_FORMAT=console
# SPOOL_LOG_LEVEL=info
# SPOOL_AUTH_DEBUG_LINKS=true
# auto (default) = Secure session cookie unless SPOOL_PUBLIC_URL is http on
# localhost / 127.0.0.1; set false only for plain http off localhost (the hub
# then logs auth.cookie_not_secure at start)
# SPOOL_COOKIE_SECURE=auto
# log = confirmation mail is written to the hub log (`docker compose logs hub`)
# SPOOL_MAIL_TRANSPORT=log

# --- local dev mode: `docker compose --profile dev up -d` (spec 148) ---------
# For a developer building spool on their own machine. The dev profile adds
# Mailpit, a mail catcher: every confirmation, password reset and invite mail
# lands in its inbox at http://localhost:8025 (REST: /api/v1/messages) and
# nothing leaves the machine. Uncomment this block to send the hub's mail
# there. Every value here is a public local default: the hub refuses the dev
# login, and hub-init the default passwords, outside local dev (never set
# SPOOL_HUB_ENV=dev or prd with this block).
# SPOOL_HUB_ENV=lde
# SPOOL_MAIL_TRANSPORT=smtp
# the Mailpit service on the compose network; it takes no login and no TLS
# SPOOL_MAIL_SMTP_HOST=mail
# SPOOL_MAIL_SMTP_PORT=1025
# SPOOL_MAIL_SMTP_TLS=none
# SPOOL_MAIL_SMTP_USER=
# SPOOL_MAIL_FROM=spool@example.org
# SPOOL_MAIL_PREFLIGHT=require
# Mailpit's ports on the host, bound to 127.0.0.1: SMTP and the web inbox
# SPOOL_MAILPIT_SMTP_PORT=1025
# SPOOL_MAILPIT_UI_PORT=8025
# the one-click "Dev login" (signs you in as the workspace owner); off by
# default, refused on a dev or prd hub
# SPOOL_AUTH_DEV_LOGIN_ENABLED=true
# The secrets the dev profile runs with, the compose defaults (override any
# of them like above). The session key needs nothing: the hub makes one on
# first start and keeps it in its state volume.
# SPOOL_DB_OWNER_PASSWORD=spool-local-owner
# SPOOL_DB_RUNTIME_PASSWORD=spool-local-runtime
# SPOOL_S3_ACCESS_KEY=spool-local-s3-access
# the superuser password and the S3 secret key: the files in
# csi-spl-api/src/docker/local-secrets (secret files, above)

# --- own domain (example: chat.example.org, DNS A/AAAA pointing here) ---------
# SPOOL_PUBLIC_URL=https://chat.example.org
# SPOOL_SITE_ADDRESS=chat.example.org
# SPOOL_DOMAIN=chat.example.org
# SPOOL_BIND=0.0.0.0
# SPOOL_HTTP_PORT=80
# SPOOL_HTTPS_PORT=443
# SPOOL_HUB_ENV=prd
# SPOOL_LOG_FORMAT=json
# SPOOL_AUTH_DEBUG_LINKS=false
# SPOOL_COOKIE_SECURE=auto
# SPOOL_MAIL_TRANSPORT=smtp
# SPOOL_MAIL_SMTP_HOST=smtp.example.org
# SPOOL_MAIL_SMTP_PORT=587
# SPOOL_MAIL_SMTP_USER=<smtp-user>
# the SMTP password: secrets/mail_smtp_password (secret files, above)
# SPOOL_MAIL_FROM=spool@example.org
# SPOOL_OWNER_EMAIL=you@example.org
# SPOOL_DB_OWNER_PASSWORD=<openssl rand -hex 24>
# SPOOL_DB_RUNTIME_PASSWORD=<openssl rand -hex 24>
# SPOOL_SECRETS_DIR=./secrets
# the hub checks the relay at start (connect + login, no mail) and refuses to
# start when it fails: `docker compose logs hub` names the problem. warn = log
# it and start anyway, off = no check
# SPOOL_MAIL_PREFLIGHT=require
