# spool standalone stack (docker-compose.yml). Every value has a working local
# default, so `docker compose up --build` runs with no .env at all. Copy this
# file to .env only to change something. Placeholders only: never commit a
# filled-in .env.
#
# Two profiles:
#   local      (the defaults)  http://localhost:8080, bound to 127.0.0.1, the
#              sign-up form shows the email-confirmation link itself
#   own domain uncomment the block at the bottom: Caddy fetches a TLS
#              certificate for SPOOL_SITE_ADDRESS, the hub runs with the
#              production rules (https only, Secure cookie, no debug links)
#              and confirmation mail goes out through your SMTP relay
# The WUI bundle bakes SPOOL_PUBLIC_URL, SPOOL_TENANT, SPOOL_LOBBY_TASK_ID and
# SPOOL_DEFAULT_LOCALE in at build time: after changing one, run
# `docker compose up --build`.

# --- where the browser reaches the stack -------------------------------------
# SPOOL_PUBLIC_URL=http://localhost:8080
# SPOOL_BIND=127.0.0.1
# SPOOL_HTTP_PORT=8080
# SPOOL_HTTPS_PORT=8443
# Caddy's site address: ":80" = plain http on any host name
# SPOOL_SITE_ADDRESS=:80
# the hub's tenant host pattern is {tenant}.<SPOOL_DOMAIN>
# SPOOL_DOMAIN=localhost

# --- the tenant seeded on first start -----------------------------------------
# On localhost the first person who signs up and confirms their email becomes
# its owner. On any other URL (or a non-loopback SPOOL_BIND) nobody does:
# hub-init invites SPOOL_OWNER_EMAIL once and prints the sign-in link
# (`docker compose logs hub-init`); only that confirmed address becomes owner.
# SPOOL_TENANT=main
# SPOOL_OWNER_EMAIL=you@example.org
# auto (default) = the rule above; true / false force it
# SPOOL_BOOTSTRAP_OWNER=auto
# SPOOL_LOBBY_TASK_ID=00000000-0000-4000-8000-000000000001
# SPOOL_DEFAULT_LOCALE=en
# The source repository the web app links to: a commit hash in a message
# links to <web url><commit path><hash>, a /help repo link to
# <web url><help path>..., and "Connect an agent" clones the clone url.
# Unset = those links are hidden. A container restart applies a change.
# SPOOL_REPO_WEB_URL=https://git.example.org/acme/spool
# SPOOL_REPO_CLONE_URL=https://git.example.org/acme/spool
# SPOOL_REPO_COMMIT_PATH=/commit/
# SPOOL_REPO_HELP_PATH=/blob/master/csi-spl-doc/doc/help/

# --- Postgres (never published outside the compose network) ------------------
# Local throwaways by default; set your own for anything but a laptop: off
# localhost hub-init REFUSES to start with these public defaults. They take
# effect on a NEW volume only (`docker compose down -v` drops the data).
# SPOOL_DB_NAME=spool_hub
# SPOOL_DB_OWNER=spool_hub
# SPOOL_DB_OWNER_PASSWORD=<choose-one>
# SPOOL_DB_RUNTIME=spool_hub_rt
# SPOOL_DB_RUNTIME_PASSWORD=<choose-one>
# SPOOL_DB_SUPERUSER_PASSWORD=<choose-one>

# --- build -----------------------------------------------------------------------
# The version the images report (/version, the WUI footer); default: git
# describe of this checkout, else the .version floor. SPOOL_IMAGE_TAG names the
# local images (spool-hub:<tag>, spool-web:<tag>), default local.
# SPOOL_VERSION=
# SPOOL_IMAGE_TAG=local

# --- hub -----------------------------------------------------------------------
# lde = local rules (http allowed, debug confirmation links allowed)
# SPOOL_HUB_ENV=lde
# SPOOL_LOG_FORMAT=console
# SPOOL_LOG_LEVEL=info
# SPOOL_AUTH_DEBUG_LINKS=true
# SPOOL_COOKIE_SECURE=false
# log = confirmation mail is written to the hub log (`docker compose logs hub`)
# SPOOL_MAIL_TRANSPORT=log

# --- own domain (example: chat.example.org, DNS A/AAAA pointing here) ---------
# SPOOL_PUBLIC_URL=https://chat.example.org
# SPOOL_SITE_ADDRESS=chat.example.org
# SPOOL_DOMAIN=chat.example.org
# SPOOL_BIND=0.0.0.0
# SPOOL_HTTP_PORT=80
# SPOOL_HTTPS_PORT=443
# SPOOL_HUB_ENV=prd
# SPOOL_LOG_FORMAT=json
# SPOOL_AUTH_DEBUG_LINKS=false
# SPOOL_COOKIE_SECURE=true
# SPOOL_MAIL_TRANSPORT=smtp
# SPOOL_MAIL_SMTP_HOST=smtp.example.org
# SPOOL_MAIL_SMTP_PORT=587
# SPOOL_MAIL_SMTP_USER=<smtp-user>
# SPOOL_MAIL_SMTP_PASSWORD=<smtp-password>
# SPOOL_MAIL_FROM=spool@example.org
# SPOOL_OWNER_EMAIL=you@example.org
# SPOOL_DB_OWNER_PASSWORD=<openssl rand -hex 24>
# SPOOL_DB_RUNTIME_PASSWORD=<openssl rand -hex 24>
# SPOOL_DB_SUPERUSER_PASSWORD=<openssl rand -hex 24>
# the hub checks the relay at start (connect + login, no mail) and refuses to
# start when it fails: `docker compose logs hub` names the problem. warn = log
# it and start anyway, off = no check
# SPOOL_MAIL_PREFLIGHT=require
