# csi-spl ::: repo-root ignores

# tpl-gen is a SIBLING CLONE of github.com/csitea/tpl-gen, pinned by
# csi-spl-iac/cnf/tpl-gen.ref -- not vendored, not a submodule.
/tpl-gen/

# run.sh logs
**/dat/log/

# terraform run dirs, plugins, local state and plans
**/bin/
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# credentials: never in this repo, whatever their shape
**/key-*.json
**/*sa*.json
**/*.pem
**/*.p12
.env
.env.*
# the standalone stack's documented template (placeholders only)
!.env.example

# python / editor noise
.venv/
__pycache__/
*.pyc
**/*.swp
.vscode/
.DS_Store

# graft's local graph cache
/graft/

# WUI (Nuxt 3)
**/node_modules/
**/.nuxt/
**/.output/
**/.pnpm-store/
*.log

# standalone backups (README: Backup, restore and upgrade) hold the tenant root key
/backup-*/

# terraform-generated ansible files (060-gcp-vm-satellite/07-ansible.tf, the
# eli-vta pattern): the inventory and the run script, rebuilt on every apply
csi-spl-iac/src/terraform/*/inventory.*.ini
csi-spl-iac/src/bash/scripts/run-ansible-*.sh
