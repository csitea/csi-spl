[
  {
    "description": "What is happening for you (hub mode): one line per topic per UTC day of the lines that name you as \u003cid\u003e@\u003cbox\u003e, blocked and ready included, and one line per UTC day of releases; JSON with a next cursor (== spool flow --as --json).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "as": {
          "description": "the acting agent id; a seated server defaults it to its seat and refuses any other",
          "type": "string"
        },
        "before": {
          "description": "the next cursor the previous page ended with",
          "type": "string"
        },
        "kind": {
          "description": "mention (takes blocked and ready too), blocked, ready or release; empty = all",
          "type": "string"
        },
        "limit": {
          "description": "topic lines per page, 1..50 (default 30)",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "name": "spool_flow"
  },
  {
    "description": "Copy a blob to dest, verifying its sha256 (== spool get-file).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "dest": {
          "description": "path to write the verified bytes to",
          "type": "string"
        },
        "file_id": {
          "description": "sha256 file_id of the blob",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "dest"
      ],
      "type": "object"
    },
    "name": "spool_get_file",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "path"
      ],
      "type": "object"
    }
  },
  {
    "description": "Issues, the way Linear keeps them (hub mode): file concrete, specced work as an issue and post your progress on it; talk stays in messages (== spool issue \u003cop\u003e --as).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "as": {
          "description": "the acting agent id; a seated server defaults it to its seat and refuses any other",
          "type": "string"
        },
        "body": {
          "description": "comment text: your progress on the issue; markdown renders, no fence needed: csi-spl-doc/doc/help/how-to-post.md; link/unlink: the topic id or /t/\u003cid\u003e link",
          "type": "string"
        },
        "issue": {
          "additionalProperties": true,
          "description": "create/update fields: title, description (markdown), status (eval|todo|wip|diss|blocked|onhold|qas|done = 01-eval, 02-todo, 03-wip, 03-diss, 05-blocked, 06-onhold, 07-qas, 09-done), priority (prio 1 highest .. 5 lowest), level (derived from the tree, read-only: 1 epic or feature, 2 issue, 3 subtask), assignee, labels, deadline (RFC 3339), epic (the epic / feature above it), parent (a level-2 issue: makes a subtask), kind (epic|feature|issue), discussions (create: the topic ids or /t/\u003cid\u003e links it links, at least one); for label: name, color",
          "type": "object"
        },
        "op": {
          "description": "one of list, get, create, update, comment, label, delete (only the issue's creator), link, unlink (one discussion, in body)",
          "type": "string"
        },
        "query": {
          "description": "list filters in URL query form, e.g. status=todo,wip\u0026assignee=me\u0026epic=SPL-17\u0026kind=issue\u0026sort=priority",
          "type": "string"
        },
        "ref": {
          "description": "issue key, e.g. SPL-12 (get, update, comment, delete)",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "name": "spool_issue"
  },
  {
    "description": "Add one note to the Notes of the person who asked you for it (hub mode): ask_msg_id is their message, the note goes to its author only; answers {msg_id, id, created_at} (== spool note add --as --json).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "archived": {
          "description": "archive the note at once",
          "type": "boolean"
        },
        "as": {
          "description": "the acting agent id; a seated server defaults it to its seat and refuses any other",
          "type": "string"
        },
        "ask_msg_id": {
          "description": "the msg_id of the person's own message that asked for the note, in a topic you read; the note goes to its author, never to a person you name",
          "type": "string"
        },
        "body": {
          "description": "the text, at most 20 000 characters",
          "type": "string"
        },
        "items": {
          "description": "checklist lines in order, at most 200 of at most 500 characters: {text, done}",
          "items": {
            "additionalProperties": false,
            "properties": {
              "done": {
                "type": "boolean"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "links": {
          "description": "at most 100 links {kind: msg|topic|issue|event|doc|channel|url, ref, workspace_id, day (an event's YYYY-MM-DD), label}; a workspace kind takes the ask's workspace, url an https:// address",
          "items": {
            "additionalProperties": false,
            "properties": {
              "day": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "workspace_id": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "pinned": {
          "description": "pin the note",
          "type": "boolean"
        },
        "priority": {
          "description": "1 (highest) .. 5; empty = 5",
          "type": "integer"
        },
        "title": {
          "description": "the title, at most 200 characters",
          "type": "string"
        }
      },
      "required": [
        "ask_msg_id"
      ],
      "type": "object"
    },
    "name": "spool_note_add"
  },
  {
    "description": "Put a file into the content-addressed blob store (== spool put-file).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "file to put into the content-addressed store",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "spool_put_file",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "type": "integer"
        },
        "file_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "bytes",
        "file_id",
        "kind",
        "name",
        "sha256"
      ],
      "type": "object"
    }
  },
  {
    "description": "Read the discussion a WUI link names (paste the browser's link): the workspace comes from the link, read through this box's desk there; refuses with the reason when no desk on this box can see it (== spool tail --url).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "json": {
          "description": "emit raw v:1 NDJSON instead of human lines",
          "type": "boolean"
        },
        "url": {
          "description": "a WUI discussion link as the browser shows it: https://\u003cworkspace host\u003e/t/\u003ctopic uuid\u003e, /m/\u003cid\u003e, or a page with ?topic=\u003ctopic uuid\u003e",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "name": "spool_read_link"
  },
  {
    "description": "Return the v:1 messages in an agent's inbox as a JSON array (== spool recv).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "ack": {
          "description": "move the returned messages to archive/",
          "type": "boolean"
        },
        "as": {
          "description": "receiving agent id; a seated server defaults it to its seat and refuses any other",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "spool_recv"
  },
  {
    "description": "Reply in the discussion a WUI link names, as this server's seat (never as a person): seats it on the desk of the link's workspace first when it has no seat there, then posts into the topic.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "the reply; markdown renders, no fence needed: csi-spl-doc/doc/help/how-to-post.md",
          "type": "string"
        },
        "kind": {
          "description": "one of task, result, note, reject, blocker, msg (default msg)",
          "type": "string"
        },
        "url": {
          "description": "the WUI discussion link to reply in (the same forms as spool_read_link)",
          "type": "string"
        }
      },
      "required": [
        "url",
        "body"
      ],
      "type": "object"
    },
    "name": "spool_reply",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "delivery": {
          "type": "string"
        },
        "msg_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "ts": {
          "type": "string"
        }
      },
      "required": [
        "delivery",
        "msg_id",
        "task_id",
        "ts"
      ],
      "type": "object"
    }
  },
  {
    "description": "Send a v:1 message to another agent, on this box or (hub mode) another box; with channel, post a new topic into that channel for every member (== spool send [--channel]).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "message text; a longer post uses markdown (headers, bold, lists, GFM pipe tables), no fence needed: csi-spl-doc/doc/help/how-to-post.md",
          "type": "string"
        },
        "channel": {
          "description": "hub mode only: post into this channel id (e.g. spool-hub-devel) as a new topic every member reads, like a human's post; leave to empty (or ALL-0) and to_box empty; refused unless the sender is a member",
          "type": "string"
        },
        "file_ids": {
          "description": "file_ids from spool_put_file to attach",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "from": {
          "description": "sender agent id, e.g. GRK-03; a seated server defaults it to its seat and refuses any other",
          "type": "string"
        },
        "kind": {
          "description": "one of task, result, note, reject, blocker (cannot proceed without input), msg (a plain message)",
          "type": "string"
        },
        "ref_task_id": {
          "description": "hub mode only: the channel topic (task_id uuid) this DM is about (== spool send --ref); kept only when the sender may read that topic",
          "type": "string"
        },
        "task_id": {
          "description": "topic uuid; a new one is minted when empty",
          "type": "string"
        },
        "to": {
          "description": "recipient agent id, e.g. CLE-07; empty for a channel post",
          "type": "string"
        },
        "to_box": {
          "description": "hub mode only: the recipient's box id when the agent id exists on several boxes (a seated server sends HUM-* to box-wui by default)",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "body"
      ],
      "type": "object"
    },
    "name": "spool_send",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "delivery": {
          "type": "string"
        },
        "msg_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "ts": {
          "type": "string"
        }
      },
      "required": [
        "delivery",
        "msg_id",
        "task_id",
        "ts"
      ],
      "type": "object"
    }
  },
  {
    "description": "List a topic oldest-first: human lines, or raw v:1 NDJSON with json=true (== spool tail).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "json": {
          "description": "emit raw v:1 NDJSON instead of human lines",
          "type": "boolean"
        },
        "task_id": {
          "description": "topic uuid",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "type": "object"
    },
    "name": "spool_tail"
  },
  {
    "description": "Export a topic as a PDF file on this machine (hub mode): the hub renders exactly what the person this box works for reads in the web UI; answers {task_id, path, bytes, rows, pictures, sha256} (== spool topic-pdf). Exit 3 = no such topic for that person, 4 = name the operator with typed_by, 5 = the renderer could not make it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "out": {
          "description": "the file to write, replaced when it exists; empty = \u003cspool root\u003e/\u003cagent id\u003e/exports/\u003cthe hub's name\u003e",
          "type": "string"
        },
        "task": {
          "description": "the topic: its uuid or a WUI link as the browser shows it (/t/\u003cuuid\u003e, /m/\u003cid\u003e, a page with ?topic=\u003cuuid\u003e)",
          "type": "string"
        },
        "typed_by": {
          "description": "HUM-\u003cn\u003e: export as this operator of the box; needed only when several are bound",
          "type": "string"
        }
      },
      "required": [
        "task"
      ],
      "type": "object"
    },
    "name": "spool_topic_pdf",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "pictures": {
          "type": "integer"
        },
        "rows": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "path",
        "bytes",
        "rows",
        "pictures",
        "sha256"
      ],
      "type": "object"
    }
  }
]