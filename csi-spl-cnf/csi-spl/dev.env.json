{
  "env": {
    "dns": {
      "BASE_DOMAIN": "spool-hub.ai",
      "env_subdomain": "dev",
      "mapped_tenants": [
        "t1"
      ],
      "fqdn": "dev.spool-hub.ai",
      "api_fqdn": "dev.api.spool-hub.ai"
    },
    "gcp": {
      "gcp_account_owner_email": "yordan.georgiev@flok.fi",
      "gcp_org_id": "1080340024101",
      "gcp_project": "csi-spl-dev",
      "gcp_region": "europe-north1",
      "state_bucket": "csi-spl-dev-tfstate"
    },
    "hub": {
