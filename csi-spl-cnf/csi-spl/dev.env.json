{
    "env": {
        "ENV": "dev",
        "ORG": "csi",
        "APP": "spl",
        "ORG_APP": "csi-spl",
        "versions": {
            "terraform_version": "1.9.8",
            "google_provider_version": "~> 6.0"
        },
        "gcp": {
            "gcp_project": "csi-spl-dev",
            "gcp_region": "europe-north1",
            "state_bucket": "csi-spl-dev-tfstate"
        },
        "steps": {
            "000-gcp-remote-bucket": {
                "bucket_name": "csi-spl-dev-tfstate"
            },
            "001-enable-gcp-services": {
                "gcp_services": [
                    "storage.googleapis.com",
                    "iam.googleapis.com"
                ]
            },
            "020-gcp-relay-bucket": {
                "relay_bucket_name": "csi-spl-74a3883f-dev",
                "object_max_age_days": 1,
                "uniform_bucket_level_access": true,
                "relay_sa_account_id": "csi-spl-rel-dev"
            }
        }
    }
}