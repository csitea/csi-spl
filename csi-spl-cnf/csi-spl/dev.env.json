        "SPOOL_HUB_ALLOW_TEXT_ONLY_WHEN_FILE_MISSING": "false",
        "SPOOL_HUB_QUEUE_TTL": "168h",
        "SPOOL_HUB_QUEUE_MAX_PER_BOX": "1000",
        "SPOOL_HUB_RETENTION_ALERTS": "168h",
        "SPOOL_HUB_RETENTION_CHANNELS": "720h",
        "SPOOL_HUB_HELLO_SKEW": "300s",
        "SPOOL_HUB_UPLOAD_TOKEN_TTL": "5m",
        "SPOOL_HUB_EDGE_WINDOW": "1m",
        "SPOOL_HUB_EDGE_WS_CONNS_TOTAL": "900",
        "SPOOL_HUB_EDGE_WS_CONNS_PER_IP": "0",
        "SPOOL_HUB_EDGE_WS_HANDSHAKES_PER_IP": "0",
        "SPOOL_HUB_EDGE_AUTH_PER_IP": "0",
        "SPOOL_HUB_HELLO_TIMEOUT": "10s",
        "SPOOL_HUB_WS_PING_INTERVAL": "30s",
        "SPOOL_HUB_WS_PING_TIMEOUT": "15s",
        "SPOOL_HUB_TRUSTED_PROXY_HOPS": "0",
        "SPOOL_HUB_CLIENT_IP_PROBE": "true",
        "SPOOL_HUB_LOBBY_TASK_ID": "00000000-0000-4000-8000-000000000001",
        "SPOOL_HUB_QUOTA_MESSAGES_PER_MONTH": "100000",
        "SPOOL_HUB_QUOTA_PINS": "256",
        "SPOOL_HUB_QUOTA_FILE_BYTES": "10737418240",
        "SPOOL_HUB_BILLING_GRACE": "168h",
        "SPOOL_HUB_LOG_LEVEL": "info",
        "SPOOL_HUB_LOG_FORMAT": "json",
        "SPOOL_HUB_MIGRATIONS_DIR": "/opt/spool/sql/postgres/spool-hub",
        "SPOOL_HUB_PAYMENT_PROVIDER": "",
        "SPOOL_HUB_PAYMENT_PLAN_ID": "default",
        "SPOOL_HUB_PAYMENT_PLAN_CENTS": "2000",
        "SPOOL_HUB_PAYMENT_CURRENCY": "eur",
        "SPOOL_HUB_PAYMENT_PUBLIC_SCHEME": "https",
        "SPOOL_HUB_PAYMENT_HOLD": "1h",
        "SPOOL_HUB_PAYMENT_CLAIM_URL": "https://dev.spool-hub.ai/checkout/claim",
        "SPOOL_HUB_PAYMENT_CLAIM_TTL": "24h",
        "SPOOL_HUB_STRIPE_PUBLISHABLE_KEY": "",
        "SPOOL_HUB_STRIPE_API_BASE": "",
        "SPOOL_HUB_STRIPE_API_VERSION": "",
        "SPOOL_HUB_ENABLE_PAYPAL": "false",
        "SPOOL_HUB_PAYPAL_CLIENT_ID": "",
        "SPOOL_HUB_PAYPAL_MODE": "sandbox",
        "SPOOL_HUB_PAYPAL_API_BASE": "",
        "SPOOL_HUB_PAYPAL_WEBHOOK_ID": "",
        "SPOOL_HUB_ENABLE_FAKE_PAY": "true",
        "SPOOL_HUB_VIEW_DOOR": "session",
        "SPOOL_HUB_VIEW_CORS_ORIGINS": "https://csi-spl-dev-site.web.app,https://csi-spl-dev-site.firebaseapp.com,https://dev.spool-hub.ai",
        "SPOOL_HUB_WUI_DISPATCH": "true",
        "SPOOL_HUB_AUTH_BOOTSTRAP_OWNER": "true",
        "SPOOL_HUB_ENV": "dev",
        "SPOOL_HUB_FILES_BUCKET": "csi-spl-dev-files",
        "SPOOL_HUB_TENANT_HOST_PATTERN": "{tenant}.dev.spool-hub.ai"
      },
      "image": {
        "name": "spool-hub",
        "sql_src": "csi-spl-rdb/src/sql/postgres/spool-hub",
        "tag": "0.1.8",
        "ref": "europe-north1-docker.pkg.dev/csi-spl-dev/csi-spl-dev-hub/spool-hub:0.1.8"
      },
      "db_user": "spool_hub",
      "cloud_sql_proxy_image": "gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.18.0",
      "secret_env": {
        "SPOOL_HUB_DB_DSN": "csi-spl-hub-db-dsn"
      },
      "wui_key": {
        "inject": "true",
        "secret_env": {
          "SPOOL_HUB_WUI_KEY": "csi-spl-hub-wui-key"
        }
      },
      "service_name": "csi-spl-hub-dev",
      "runtime_sa_account_id": "csi-spl-hub-dev"
    },
    "auth": {
      "social": {
        "env": {
          "SPOOL_HUB_AUTH_PROVIDERS": "google",
          "SPOOL_HUB_AUTH_APP_URL": "https://dev.spool-hub.ai",
          "SPOOL_HUB_AUTH_SESSION_TTL": "12h",
          "SPOOL_HUB_AUTH_STATE_TTL": "15m",
          "SPOOL_HUB_AUTH_COOKIE_NAME": "spool_session_dev",
          "SPOOL_HUB_AUTH_COOKIE_DOMAIN": "spool-hub.ai",
          "SPOOL_HUB_AUTH_COOKIE_SECURE": "true",
          "SPOOL_HUB_AUTH_STATE_COOKIE_NAME": "__session",
          "SPOOL_HUB_AUTH_GOOGLE_CLIENT_ID": "436311356630-srfr43efrcnpt2r62vabjgnlcaovlp1f.apps.googleusercontent.com",
          "SPOOL_HUB_AUTH_GOOGLE_REDIRECT_URI": "https://dev.spool-hub.ai/api/v1/auth/google/callback",
          "SPOOL_HUB_AUTH_GOOGLE_SCOPES": "openid email profile",
          "SPOOL_HUB_AUTH_FACEBOOK_CLIENT_ID": "PLACEHOLDER-facebook-app-id",
          "SPOOL_HUB_AUTH_FACEBOOK_REDIRECT_URI": "https://dev.spool-hub.ai/api/v1/auth/facebook/callback",
          "SPOOL_HUB_AUTH_FACEBOOK_SCOPES": "email,public_profile",
          "SPOOL_HUB_AUTH_MICROSOFT_CLIENT_ID": "PLACEHOLDER-microsoft-client-id",
          "SPOOL_HUB_AUTH_MICROSOFT_REDIRECT_URI": "https://dev.spool-hub.ai/api/v1/auth/microsoft/callback",
          "SPOOL_HUB_AUTH_MICROSOFT_SCOPES": "openid email profile",
          "SPOOL_HUB_AUTH_MICROSOFT_TENANT": "common",
          "SPOOL_HUB_AUTH_MICROSOFT_TRUST_EMAIL": "false",
          "SPOOL_HUB_AUTH_LINKEDIN_CLIENT_ID": "PLACEHOLDER-linkedin-client-id",
          "SPOOL_HUB_AUTH_LINKEDIN_REDIRECT_URI": "https://dev.spool-hub.ai/api/v1/auth/linkedin/callback",
          "SPOOL_HUB_AUTH_LINKEDIN_SCOPES": "openid profile email",
          "SPOOL_HUB_AUTH_XAI_CLIENT_ID": "PLACEHOLDER-xai-client-id",
          "SPOOL_HUB_AUTH_XAI_REDIRECT_URI": "https://dev.spool-hub.ai/api/v1/auth/xai/callback",
          "SPOOL_HUB_AUTH_XAI_SCOPES": "openid profile email",
          "SPOOL_HUB_AUTH_XAI_AUTH_URL": "https://auth.x.ai/oauth2/authorize",
          "SPOOL_HUB_AUTH_XAI_TOKEN_URL": "https://auth.x.ai/oauth2/token",
          "SPOOL_HUB_AUTH_XAI_USERINFO_URL": "https://auth.x.ai/oauth2/userinfo"
        },
        "secret_env": {
          "SPOOL_HUB_AUTH_SESSION_KEY": "csi-spl-hub-auth-session-key",
          "SPOOL_HUB_AUTH_GOOGLE_CLIENT_SECRET": "csi-spl-hub-auth-google-client-secret",
          "SPOOL_HUB_AUTH_FACEBOOK_CLIENT_SECRET": "csi-spl-hub-auth-facebook-client-secret",
          "SPOOL_HUB_AUTH_MICROSOFT_CLIENT_SECRET": "csi-spl-hub-auth-microsoft-client-secret",
          "SPOOL_HUB_AUTH_LINKEDIN_CLIENT_SECRET": "csi-spl-hub-auth-linkedin-client-secret",
          "SPOOL_HUB_AUTH_XAI_CLIENT_SECRET": "csi-spl-hub-auth-xai-client-secret"
        }
      },
      "native": {
        "env": {
          "SPOOL_HUB_AUTH_NATIVE_ENABLED": "true",
          "SPOOL_HUB_AUTH_NATIVE_VERIFY_REQUIRED": "true",
          "SPOOL_HUB_AUTH_NATIVE_DEBUG_TOKENS": "true"
        }
      }
    },
    "mail": {
      "env": {
        "SPOOL_HUB_MAIL_TRANSPORT": "log",
        "SPOOL_HUB_MAIL_SMTP_HOST": "PLACEHOLDER-smtp-host",
        "SPOOL_HUB_MAIL_SMTP_PORT": "0",
        "SPOOL_HUB_MAIL_SMTP_USER": "PLACEHOLDER-smtp-user",
        "SPOOL_HUB_MAIL_SMTP_TLS": "starttls",
        "SPOOL_HUB_MAIL_FROM": "PLACEHOLDER-mail-from",
        "SPOOL_HUB_MAIL_FROM_NAME": "PLACEHOLDER-mail-from-name"
      },
      "secret_env": {
        "SPOOL_HUB_MAIL_SMTP_PASSWORD": "csi-spl-hub-mail-smtp-password"
      }
    },
    "payment": {
      "secret_env": {
        "SPOOL_HUB_STRIPE_SECRET_KEY": "csi-spl-hub-stripe-secret-key",
        "SPOOL_HUB_STRIPE_WEBHOOK_SECRET": "csi-spl-hub-stripe-webhook-secret",
        "SPOOL_HUB_PAYPAL_CLIENT_SECRET": "csi-spl-hub-paypal-client-secret"
      }
    },
    "box": {
      "spool_root": "/var/spool-hub",
      "spool_root_group": "spool-agents",
      "spool_root_other": "---"
    },
    "ENV": "dev",
    "ORG": "csi",
    "APP": "spl",
    "ORG_APP": "csi-spl",
    "versions": {
      "terraform_version": "1.9.8",
      "infra_version": "1.0.0",
      "google_provider_version": "~> 6.0"
    },
    "steps": {
      "000-gcp-remote-bucket": {
        "bucket_name": "csi-spl-dev-tfstate"
      },
      "001-enable-gcp-services": {
        "gcp_services": [
          "storage.googleapis.com",
          "iam.googleapis.com",
          "orgpolicy.googleapis.com",
          "run.googleapis.com",
          "sqladmin.googleapis.com",
          "secretmanager.googleapis.com",
          "artifactregistry.googleapis.com",
          "dns.googleapis.com",
          "compute.googleapis.com",
          "certificatemanager.googleapis.com",
          "iamcredentials.googleapis.com",
          "sts.googleapis.com",
          "firebase.googleapis.com",
          "firebasehosting.googleapis.com",
          "siteverification.googleapis.com"
        ]
      },
      "005-gcp-domain-verification": {
        "prd_zone_name": "spool-hub",
        "parent_zone_project": "csi-spl-prd",
        "verification_records": []
      },
      "016-firebase-deploy-iam": {
        "deploy_sa_account_id": "csi-spl-dev-fb-deploy",
        "deploy_roles": [
          "roles/firebasehosting.admin",
          "roles/serviceusage.serviceUsageConsumer",
          "roles/run.viewer"
        ],
        "bind_github_wif": false
      },
      "017-github-wif-deploy": {
        "github_repository": "csitea/csi-spl",
        "github_ref": "refs/heads/master",
        "pool_id": "github-actions",
        "provider_id": "github",
        "deploy_sa_account_id": "csi-spl-deploy-dev"
      },
      "019-firebase-static-site": {
        "site_id": "csi-spl-dev-site",
        "cert_preference": "GROUPED",
        "wait_dns_verification": false,
        "additional_fqdns": [],
        "bind_custom_domain": false,
        "wui_deploy": true,
        "wui_default_tenant": "t1"
      },
      "020-gcp-relay-bucket": {
        "relay_bucket_name": "csi-spl-dev-rel",
        "object_max_age_days": 1,
        "soft_delete_retention_seconds": 604800,
        "relay_sa_account_id": "csi-spl-rel-dev"
      },
      "025-gcp-dns-zone": {
        "zone_name": "spool-hub-dev",
        "zone_description": "spool hub dev subzone: created by 025-gcp-dns-zone, delegated from the prd apex zone",
        "parent_zone_name": "spool-hub",
        "parent_zone_project": "csi-spl-prd",
        "cloud_run_mapping_records": [],
        "mapped_tenant_records": false
      },
      "028-gcp-artifact-registry": {
        "repository_id": "csi-spl-dev-hub",
        "immutable_tags": true,
        "untagged_max_age_days": 7
      },
      "030-cloud-run-hub": {
        "health_path": "/healthz",
        "allow_unauthenticated": true
      },
      "031-gcp-hub-ingress": {
        "allowed_ip_ranges": [
          "0.0.0.0/0"
        ],
        "wui_origin_host": "csi-spl-dev-site.web.app",
        "l7_narrowing": true,
        "hub_paths": [
          "/v1/*",
          "/api/*",
          "/healthz",
          "/version"
        ],
        "hub_path_regex": "^/(v1/|api/v1/|healthz$|version$)",
        "extra_host_labels": [
          "dev.api"
        ],
        "dns_managed_zone": "spool-hub-dev",
        "dns_zone_project": "",
        "extra_dns_managed_zone": "spool-hub",
        "extra_dns_zone_project": "csi-spl-prd"
      },
      "032-gcp-cloud-run-domain-mapping": {
        "additional_host_labels": []
      },
      "040-cloud-sql-postgres": {
        "instance_name": "csi-spl-dev-pg",
        "database_version": "POSTGRES_16",
        "tier": "db-f1-micro",
        "availability_type": "ZONAL",
        "disk_size_gb": 10,
        "database_name": "spool",
        "deletion_protection": false,
        "backup_enabled": true
      },
      "050-gcs-files": {
        "files_bucket_name": "csi-spl-dev-files",
        "soft_delete_retention_seconds": 604800,
        "object_max_age_days": 0
      },
      "120-github-general-secrets": {
        "gh_repo": "csitea/csi-spl"
      }
    }
  }
}
