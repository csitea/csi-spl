        "uptime_period_seconds": 60,
        "uptime_timeout_seconds": 10,
        "uptime_failing_regions": 1,
        "uptime_fail_seconds": 120,
        "rate_429_per_min": 20,
        "rate_5xx_per_5min": 5,
        "error_logs_per_5min": 10,
