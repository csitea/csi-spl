    "steps": {
      "000-gcp-remote-bucket": {
        "bucket_name": "csi-spl-prd-tfstate"
      },
      "001-enable-gcp-services": {
        "gcp_services": [
          "storage.googleapis.com",
          "iam.googleapis.com",
          "orgpolicy.googleapis.com",
          "run.googleapis.com",
          "sqladmin.googleapis.com",
          "secretmanager.googleapis.com",
          "artifactregistry.googleapis.com",
          "dns.googleapis.com",
          "compute.googleapis.com",
          "certificatemanager.googleapis.com",
          "iamcredentials.googleapis.com",
          "sts.googleapis.com",
          "firebase.googleapis.com",
          "firebasehosting.googleapis.com",
          "siteverification.googleapis.com"
        ]
      },
      "005-gcp-domain-verification": {
        "prd_zone_name": "spool-hub",
        "parent_zone_project": "csi-spl-prd",
        "verification_records": [
          {
            "source": "anwhextvuu2i.spool-hub.ai.",
            "target": "gv-farvs6rreemzgv.dv.googlehosted.com."
          }
        ]
      },
      "016-firebase-deploy-iam": {
        "deploy_sa_account_id": "csi-spl-prd-fb-deploy",
        "deploy_roles": [
          "roles/firebasehosting.admin",
          "roles/serviceusage.serviceUsageConsumer",
          "roles/run.viewer"
        ],
        "bind_github_wif": false
      },
      "017-github-wif-deploy": {
        "github_repository": "csitea/csi-spl",
        "github_ref": "refs/heads/master",
        "pool_id": "github-actions",
        "provider_id": "github",
        "deploy_sa_account_id": "csi-spl-deploy-prd"
      },
      "019-firebase-static-site": {
        "site_id": "csi-spl-prd-site",
        "cert_preference": "GROUPED",
        "wait_dns_verification": false,
        "additional_fqdns": [],
        "bind_custom_domain": true,
        "wui_deploy": true,
        "wui_auth_base": "https://api.spool-hub.ai",
        "wui_default_tenant": "t1"
      },
      "020-gcp-relay-bucket": {
        "relay_bucket_name": "csi-spl-prd-rel",
        "object_max_age_days": 1,
        "soft_delete_retention_seconds": 604800,
        "relay_sa_account_id": "csi-spl-rel-prd"
      },
      "025-gcp-dns-zone": {
        "zone_name": "spool-hub",
        "zone_description": "spool hub public zone: adopted by 025-gcp-dns-zone, never recreate (registrar NS)",
        "parent_zone_name": "",
        "parent_zone_project": "",
        "cloud_run_mapping_records": [
          {
            "name": "api",
            "type": "A",
            "rrdatas": [
              "216.239.32.21",
              "216.239.34.21",
              "216.239.36.21",
              "216.239.38.21"
            ]
          },
          {
            "name": "api",
            "type": "AAAA",
            "rrdatas": [
              "2001:4860:4802:32::15",
              "2001:4860:4802:34::15",
              "2001:4860:4802:36::15",
              "2001:4860:4802:38::15"
            ]
          },
          {
            "name": "dev.api",
            "type": "CNAME",
            "rrdatas": [
              "ghs.googlehosted.com."
            ]
          }
        ],
        "mapped_tenant_records": true
      },
      "028-gcp-artifact-registry": {
        "repository_id": "csi-spl-prd-hub",
        "immutable_tags": true,
        "untagged_max_age_days": 7
      },
      "030-cloud-run-hub": {
        "health_path": "/healthz",
        "allow_unauthenticated": true
      },
      "032-gcp-cloud-run-domain-mapping": {
        "additional_host_labels": []
      },
      "040-cloud-sql-postgres": {
        "instance_name": "csi-spl-prd-pg",
        "database_version": "POSTGRES_16",
        "tier": "db-f1-micro",
        "availability_type": "ZONAL",
        "disk_size_gb": 10,
        "database_name": "spool",
        "deletion_protection": true,
        "backup_enabled": true,
        "query_insights_enabled": true,
        "query_insights_string_length": 1024,
        "query_insights_plans_per_minute": 5
      },
      "045-gcs-db-backups": {
        "instance_name": "csi-spl-prd-pg",
        "backups_bucket_name": "csi-spl-prd-db-backups",
        "backup_max_age_days": 30,
        "soft_delete_retention_seconds": 604800
      },
      "050-gcs-files": {
        "files_bucket_name": "csi-spl-prd-files",
        "soft_delete_retention_seconds": 604800,
        "object_max_age_days": 0
      },
      "120-github-general-secrets": {
        "gh_repo": "csitea/csi-spl"
      }
    }
