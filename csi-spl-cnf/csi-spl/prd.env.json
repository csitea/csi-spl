{
  "env": {
    "dns": {
      "BASE_DOMAIN": "spool-hub.ai",
      "env_subdomain": "",
      "fqdn": "spool-hub.ai"
    },
    "hub": {
      "cloud_run": {
        "port": 8080,
        "cpu": "1",
        "memory": "512Mi",
        "min_instances": 1,
        "max_instances": 1,
        "concurrency": 1000,
        "timeout_seconds": 3600,
        "ingress": "internal-and-cloud-load-balancing"
      },
      "env": {
        "SPOOL_HUB_LISTEN_ADDR": ":8080",
        "SPOOL_HUB_ALLOW_TEXT_ONLY_WHEN_FILE_MISSING": "false",
        "SPOOL_HUB_QUEUE_TTL": "168h",
        "SPOOL_HUB_QUEUE_MAX_PER_BOX": "1000",
        "SPOOL_HUB_RETENTION_ALERTS": "168h",
        "SPOOL_HUB_RETENTION_CHANNELS": "720h",
        "SPOOL_HUB_HELLO_SKEW": "300s",
        "SPOOL_HUB_UPLOAD_TOKEN_TTL": "5m",
        "SPOOL_HUB_QUOTA_MESSAGES_PER_MONTH": "100000",
        "SPOOL_HUB_QUOTA_PINS": "256",
        "SPOOL_HUB_QUOTA_FILE_BYTES": "10737418240",
        "SPOOL_HUB_BILLING_GRACE": "168h",
        "SPOOL_HUB_LOG_LEVEL": "info",
        "SPOOL_HUB_LOG_FORMAT": "json",
        "SPOOL_HUB_MIGRATIONS_DIR": "/opt/spool/sql/postgres/spool-hub",
        "SPOOL_HUB_ENV": "prd",
        "SPOOL_HUB_FILES_BUCKET": "csi-spl-prd-files",
        "SPOOL_HUB_TENANT_HOST_PATTERN": "{tenant}.spool-hub.ai",
        "SPOOL_HUB_ENABLE_FAKE_PAY": "false",
        "SPOOL_HUB_PAYMENT_API_BASE": "",
        "SPOOL_HUB_PAYMENT_API_VERSION": "",
        "SPOOL_HUB_PAYMENT_CURRENCY": "eur",
        "SPOOL_HUB_PAYMENT_PLAN_CENTS": "0",
        "SPOOL_HUB_PAYMENT_PLAN_ID": "default",
        "SPOOL_HUB_PAYMENT_PROVIDER": "",
        "SPOOL_HUB_PAYMENT_PUBLIC_SCHEME": "https",
        "SPOOL_HUB_PAYMENT_WEBHOOK_SIG_HEADER": "X-Webhook-Signature"
      },
      "image": {
        "name": "spool-hub",
        "sql_src": "csi-spl-rdb/src/sql/postgres/spool-hub",
        "tag": "0.1.0",
        "ref": "europe-north1-docker.pkg.dev/csi-spl-prd/csi-spl-prd-hub/spool-hub:0.1.0"
      },
      "db_user": "spool_hub",
      "secret_env": {
        "SPOOL_HUB_DB_DSN": "csi-spl-hub-db-dsn"
      },
      "service_name": "csi-spl-hub-prd",
      "runtime_sa_account_id": "csi-spl-hub-prd"
    },
    "box": {
      "spool_root": "/var/spool-hub",
      "spool_root_group": "",
      "spool_root_other": "rwx"
    },
    "ENV": "prd",
    "ORG": "csi",
    "APP": "spl",
    "ORG_APP": "csi-spl",
    "versions": {
      "terraform_version": "1.9.8",
      "google_provider_version": "~> 6.0"
    },
    "gcp": {
      "gcp_project": "csi-spl-prd",
      "gcp_region": "europe-north1",
      "state_bucket": "csi-spl-prd-tfstate"
    },
    "steps": {
      "000-gcp-remote-bucket": {
        "bucket_name": "csi-spl-prd-tfstate"
      },
      "001-enable-gcp-services": {
        "gcp_services": [
          "storage.googleapis.com",
          "iam.googleapis.com",
          "orgpolicy.googleapis.com",
          "run.googleapis.com",
          "sqladmin.googleapis.com",
          "secretmanager.googleapis.com",
          "artifactregistry.googleapis.com",
          "dns.googleapis.com",
          "compute.googleapis.com",
          "certificatemanager.googleapis.com",
          "firebase.googleapis.com",
          "firebasehosting.googleapis.com"
        ]
      },
      "016-firebase-deploy-iam": {
        "deploy_sa_account_id": "csi-spl-prd-fb-deploy",
        "deploy_roles": [
          "roles/firebasehosting.admin",
          "roles/serviceusage.serviceUsageConsumer",
          "roles/run.viewer"
        ]
      },
      "019-firebase-static-site": {
        "site_id": "csi-spl-prd-site",
        "cert_preference": "GROUPED",
        "wait_dns_verification": false,
        "additional_fqdns": []
      },
      "020-gcp-relay-bucket": {
        "relay_bucket_name": "csi-spl-prd-rel",
        "object_max_age_days": 1,
        "soft_delete_retention_seconds": 604800,
        "relay_sa_account_id": "csi-spl-rel-prd"
      },
      "028-gcp-artifact-registry": {
        "repository_id": "csi-spl-prd-hub",
        "immutable_tags": true,
        "untagged_max_age_days": 7
      },
      "030-cloud-run-hub": {
        "health_path": "/healthz",
        "allow_unauthenticated": true
      },
      "031-gcp-hub-ingress": {
        "allowed_ip_ranges": [],
        "dns_managed_zone": ""
      },
      "040-cloud-sql-postgres": {
        "instance_name": "csi-spl-prd-pg",
        "database_version": "POSTGRES_16",
        "tier": "db-g1-small",
        "availability_type": "ZONAL",
        "disk_size_gb": 10,
        "database_name": "spool",
        "deletion_protection": true,
        "backup_enabled": true
      },
      "050-gcs-files": {
        "files_bucket_name": "csi-spl-prd-files",
        "soft_delete_retention_seconds": 604800,
        "object_max_age_days": 0
      }
    }
  }
}
