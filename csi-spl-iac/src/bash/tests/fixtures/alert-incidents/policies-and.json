[
 {
  "displayName": "o-a-dev and apart",
  "enabled": true,
  "combiner": "AND",
  "conditions": [
   {
    "displayName": "above 0 on and_a",
    "conditionThreshold": {
     "filter": "metric.type = \"fixture.test/and_a\" AND resource.type = \"cloud_run_revision\"",
     "comparison": "COMPARISON_GT",
     "thresholdValue": 0,
     "duration": "0s",
     "aggregations": [
      {
       "alignmentPeriod": "60s",
       "perSeriesAligner": "ALIGN_MAX",
       "groupByFields": [
        "resource.label.revision_name"
