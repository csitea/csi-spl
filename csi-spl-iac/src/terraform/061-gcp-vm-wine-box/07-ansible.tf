# Terraform writes the inventory and the run script. do_tf_apply runs the
# script after the apply, inside the tf-runner. The playbook itself is
# standalone: inventory + one vars file, no checkout required. The vars file
# is the one tpl-gen renders from cnf.
#
# The inventory reaches the VM through IAP (satellite-iap-proxy.sh, reused,
# not copied). The public address is for a later plain SSH tunnel from a
# source range added to ssh_source_ranges. Neither generated file holds a
# secret. Both are git-ignored.

locals {
  ansible_step      = "061-gcp-vm-wine-box"
  ansible_dir       = "${var.proj_path}/src/terraform/${local.ansible_step}"
  ansible_inventory = "${local.ansible_dir}/inventory.${var.env}.ini"
  ansible_script    = "${var.proj_path}/src/bash/scripts/run-ansible-${var.org}-${var.app}-${var.env}-${local.ansible_step}.sh"
  ansible_log       = "${var.proj_path}/dat/log/ansible.${local.ansible_step}.${var.org}-${var.app}-${var.env}.log"
  ansible_vars      = "${trimsuffix(var.proj_path, "/csi-spl-iac")}/csi-spl-cnf/csi-spl/${var.env}/tf/${local.ansible_step}.ansible.yml"
  ssh_private_key   = trimsuffix(pathexpand(var.ssh_public_key_file), ".pub")
  iap_proxy         = "${var.proj_path}/src/bash/scripts/satellite-iap-proxy.sh"
  ansible_files     = var.proj_path == "" ? 0 : 1
}

resource "local_file" "ansible_inventory" {
  count           = local.ansible_files
  filename        = local.ansible_inventory
  file_permission = "0644"
  content         = <<-EOT
    # GENERATED by terraform ${local.ansible_step} (07-ansible.tf); do not edit, re-apply.
    [wine_box]
    ${google_compute_instance.wine.name} ansible_user=${var.os_user} ansible_ssh_private_key_file=${local.ssh_private_key} ansible_python_interpreter=/usr/bin/python3

    [wine_box:vars]
    ansible_ssh_common_args='-o ProxyCommand="bash ${local.iap_proxy} ${var.gcp_project} ${var.gcp_zone} %h %p" -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=~/.ssh/known_hosts.wine-box -o ServerAliveInterval=30 -o ConnectTimeout=60'
  EOT
}

resource "local_file" "ansible_script" {
  count           = local.ansible_files
  filename        = local.ansible_script
  file_permission = "0755"
  content         = <<-EOT
    #!/bin/bash
    # GENERATED by terraform ${local.ansible_step} (07-ansible.tf); do not edit, re-apply.
    # Syntax-check, then box-playbook.yaml. Extra args pass through
    # (for example --check --diff, or a second run that must change nothing).
    set -uo pipefail
    export ANSIBLE_FORCE_COLOR=true PYTHONUNBUFFERED=1
    export ANSIBLE_ROLES_PATH=${local.ansible_dir}/roles
    mkdir -p "$(dirname ${local.ansible_log})"
    test -f ${local.ansible_vars} || { echo "missing vars file ${local.ansible_vars}"; exit 1; }
    # Overrides the empty list in the rendered vars file. The value is
    # TF_VAR_desktop_user_ssh_public_keys; the committed vars file stays [].
    tester_keys_json='${jsonencode({ desktop_user_ssh_public_keys = var.desktop_user_ssh_public_keys })}'

    kh=~/.ssh/known_hosts.wine-box id_file=~/.ssh/known_hosts.wine-box.instance
    if [ "$(cat "$id_file" 2>/dev/null)" != "${google_compute_instance.wine.instance_id}" ]; then
      ssh-keygen -R ${google_compute_instance.wine.name} -f "$kh" >/dev/null 2>&1 || true
      rm -f "$kh.old"
      echo "${google_compute_instance.wine.instance_id}" >"$id_file"
    fi

    ansible-playbook --syntax-check -i ${local.ansible_inventory} -e @${local.ansible_vars} -e "$tester_keys_json" ${local.ansible_dir}/box-playbook.yaml \
      || { echo "Syntax check failed, exiting..."; exit 1; }

    timeout 60m ansible-playbook ${local.ansible_dir}/box-playbook.yaml \
      -i ${local.ansible_inventory} \
      -e @${local.ansible_vars} \
      -e "$tester_keys_json" \
      "$@" 2>&1 | tee -a ${local.ansible_log}
    exit "$${PIPESTATUS[0]}"
  EOT
}
