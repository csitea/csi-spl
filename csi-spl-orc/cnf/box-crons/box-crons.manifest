# box-crons.manifest - the box owner's spool cron jobs (specs/069 lane Y3),
# installed by `./run -a do_install_box_crons` as lines tagged
# `# csi-spl:box-cron:<name>` in the box user's crontab.
#
# One row per job, fields separated by `|` (blanks around a field trimmed):
#   name     - the tag suffix, [a-z0-9-]+, unique
#   schedule - the five cron fields, or @reboot
#   script   - relative to csi-spl-orc; run with /bin/bash
#   log      - relative to BOX_CRONS_STATE_DIR (default /var/csi/csi-spl);
#              stdout and stderr are appended to it
#   replaces - comma-separated paths below an engine checkout (`ysg-box/`) of
#              the engine jobs this row takes over: a crontab line naming one
#              of them (commented or not) is removed when this row installs
#   as       - empty: the box user's crontab (the user running the install).
#              A row whose job reads or writes a desk (spl_desk_dir,
#              spl_desk_glob, spl_desk_roots) is marked with the desk it
#              reaches, and goes to the crontab of the user (the running one
#              or spl_desk_user) whose state root holds that desk's pin: a
#              moved desk is 0700 under its user (spec 069 section 8.3.1,
#              SPL-4558). `desk`: <SPOOL_FLEET_TENANT>/<the box's desk id>;
#              `desk:rsp`: <SPOOL_FLEET_TENANT>/<SPOOL_RSP_BOX>; `desk:any`:
#              reads no one desk (the roots only), stays where it is.
#              tests/box-crons-desk-reach.py measures the marked set from the
#              code; install-box-crons.tst.sh fails when a mark disagrees.
#
# name              | schedule        | script                                                  | log                   | replaces | as
box-save-sessions   | * * * * *       | src/bash/features/box-sessions/scripts/save-sessions.sh | box-sessions/save.log | ysg-box-orc/src/bash/features/claude-sessions/scripts/claude-save-sessions.sh,src/bash/scripts/agent-save-sessions.sh
box-sessions-boot   | @reboot         | src/bash/features/box-sessions/scripts/sessions-boot.sh | box-sessions/boot.log | ysg-box-orc/src/bash/features/claude-sessions/scripts/claude-sessions-boot.sh,src/bash/scripts/agent-tmux-boot.sh
graft-index-refresh | */15 8-19 * * * | src/bash/features/graft/scripts/graft-cron.sh           | graft/cron.log        | ysg-box-orc/src/bash/features/graft/scripts/graft-cron.sh
graft-index-final   | 0 20 * * *      | src/bash/features/graft/scripts/graft-cron.sh           | graft/cron.log        | ysg-box-orc/src/bash/features/graft/scripts/graft-cron.sh
msg-unreadable      | 17 7 * * *      | src/bash/scripts/msg-unreadable-cron.sh                 | msg-unreadable/cron.log |
box-state-backup    | 41 2 * * *      | src/bash/scripts/box-state-backup-cron.sh               | box-state/backup.log  |
ci-red-note       | */10 * * * *    | src/bash/scripts/ci-red-note-cron.sh                    | ci-red-note/cron.log  |
agent-login-check | * * * * *       | src/bash/scripts/agent-login-check-cron.sh               | agent-login-check/cron.log |
lane-rotate       | * * * * *       | src/bash/scripts/lane-rotate-cron.sh                    | lane-rotate/cron.log  |
uplink-probe      | * * * * *       | src/bash/scripts/uplink-probe-cron.sh                   | uplink-probe/cron.log |
qas-ci-accept     | 23 * * * *      | src/bash/scripts/qas-ci-accept-cron.sh                  | qas-ci-accept/cron.log | | desk
owner-digest      | 7 * * * *       | src/bash/scripts/owner-digest-cron.sh                   | owner-digest/cron.log | | desk
issue-close-landed | */5 * * * *     | src/bash/scripts/issue-close-landed-cron.sh             | issue-close-landed/cron.log | | desk:rsp
# spec 150 3.4 item 4 (SPL-4813): the discussions' priorities reach their issues and lanes; acts on the dispatch holder's box
topic-prio-sync   | */5 * * * *     | src/bash/scripts/topic-prio-sync-cron.sh                | topic-prio-sync/cron.log | | desk
done-claim-check  | */5 * * * *     | src/bash/scripts/done-claim-check-cron.sh               | done-claim-check/cron.log |
archived-seats-free | */5 * * * *   | src/bash/scripts/archived-seats-free-cron.sh            | archived-seats-free/cron.log | | desk
issue-key-rate    | 53 6 * * 1      | src/bash/scripts/issue-key-rate-cron.sh                 | issue-key-rate/cron.log |
gc                | * * * * *       | src/bash/scripts/gc-cron.sh                             | gc/cron.log           |
reverse-tunnel    | * * * * *       | src/bash/scripts/reverse-tunnel-cron.sh                 | reverse-tunnel/cron.log |
token-burn        | * * * * *       | src/bash/scripts/token-burn-collect-cron.sh             | token-burn/cron.log   | | desk
topic-status-card | */5 * * * *    | src/bash/scripts/topic-status-card-cron.sh             | topic-status-card/cron.log | | desk
fx-rates-fetch    | 37 16 * * *     | src/bash/scripts/fx-rates-fetch-cron.sh                 | fx-rates-fetch/cron.log |
push-orphan-check | * * * * *       | src/bash/scripts/push-orphan-check-cron.sh              | push-orphan-check/cron.log |
restore-drill-red-note | 7,37 * * * *  | src/bash/scripts/restore-drill-red-note-cron.sh         | restore-drill-red-note/cron.log |
login2-sync       | */5 * * * *     | src/bash/scripts/login2-sync-cron.sh                    | login2-sync/cron.log  |
file-streams      | * * * * *       | src/bash/scripts/file-stream-follow-cron.sh             | file-streams/cron.log | | desk:any
weekly-limit-alert | */5 * * * *    | src/bash/scripts/weekly-limit-alert-cron.sh             | weekly-limit-alert/cron.log | | desk
# SPL-4964: the queue waits, the boxes are idle, nothing landed: one post naming the hold (spec 146)
fleet-stopped-alarm | */5 * * * *   | src/bash/scripts/fleet-stopped-alarm-cron.sh            | fleet-stopped-alarm/cron.log | | desk
# SPL-4816: a box relay link stuck > 7 min alerts the box topic's seat (owner msg 7e8d02b4)
box-link-watch      | * * * * *       | src/bash/scripts/box-link-watch-cron.sh                   | box-link-watch/cron.log | | desk
# spec 166 row B6: the night zombie-topic sweep; acts once a night on the dispatch holder's box
zombie-topics     | */15 * * * *    | src/bash/scripts/zombie-topics-cron.sh                  | zombie-topics/cron.log | | desk
# spec 166 row B8: the night's reflection, gathered and queued once a night on the dispatch holder's box
reflection        | */15 * * * *    | src/bash/scripts/reflection-cron.sh                     | reflection/cron.log   | | desk
# SPL-4988 (spec 065 L15): a master commit older than the limit has no release note row; posts from the dispatch holder's box
release-notes-lag-alarm | */15 * * * * | src/bash/scripts/release-notes-lag-alarm-cron.sh | release-notes-lag-alarm/cron.log | | desk
# reliability round (spec 146, SPL-4064): one row per box check; row 10 runs
