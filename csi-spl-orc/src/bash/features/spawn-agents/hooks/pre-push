#!/usr/bin/env bash
# pre-push (SPL-1252) — the deploy-gate pre-push hook installed per worktree by
# the spawn harness. It runs the ONE pre-push gate (SPL-1251,
# `do_check_pre_push` FAST) over the worktree the push comes from, so a break is
# caught in the lane that wrote it instead of after it has stalled every deploy.
#
# It is deliberately FAIL-OPEN on any infrastructure doubt (not the spool tree,
# no ./run, git it cannot read): a hook that blocks a push it cannot even reason
# about would be worse than the gate it replaces. It REFUSES (exit 1) only when
# the gate itself runs and fails.
#
# Emergency override:  SPL_PREPUSH_OVERRIDE=1 git push …   skips the slow parts
# but still runs the seconds-cheap correctness parts (hygiene, lint-migration:
# PRE_PUSH_ONLY=override), and writes an audit line, so a deliberate bypass is
# never silent. 2026-10-04: an override that skipped everything landed a
# duplicate migration 0119. Only a poisoned shared git config (below), which
# would make the gate read the wrong tree, skips them too.
#
# The gate runs its FAST tier on the parts the push touches (CLE-77824): the
# slow checks (go test -race, hub-pg, hub-gcs, terraform validate, tpl-gen
# renders) are CI's (workflow 10/20). It writes one verdict line per part into
# the same log; this hook adds the overall verdict and its wall time.
# SPL_PREPUSH_TIER=full runs the slow tier too.
#
# git runs this with CWD at the top of the pushing worktree and passes the
# remote name/URL as $1/$2 and the ref list on stdin; the gate is over the whole
# worktree, so those are only logged, not used to scope it.
set -uo pipefail

_pp_log_dir="${SPL_PREPUSH_LOG_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/csi-spl}"
_pp_log="$_pp_log_dir/pre-push.log"
mkdir -p "$_pp_log_dir" 2>/dev/null || true
_pp_who="${SPOOL_AGENT_ID:-${MCP_BOT_AGENT_ID:-${USER:-$(id -un 2>/dev/null)}}}"
_pp_now() { date -u +%FT%TZ 2>/dev/null || echo "?"; }
_pp_logline() { printf '%s %s %s\n' "$(_pp_now)" "$_pp_who" "$*" >>"$_pp_log" 2>/dev/null || true; }

head="$(git rev-parse --short HEAD 2>/dev/null || echo '?')"
_pp_t0="$(date +%s 2>/dev/null || echo 0)"
_pp_secs() { echo "$(( $(date +%s 2>/dev/null || echo 0) - _pp_t0 ))s"; }

_pp_override="${SPL_PREPUSH_OVERRIDE:-0}"
# The git env a hook inherits (GIT_DIR, GIT_INDEX_FILE, ...) is scrubbed before
# the gate runs: its tests create commits and set config in THROWAWAY repos,
# and an inherited GIT_DIR made those land on the pushing branch and the shared
# config (junk "head/pinned/tip" commits, core.bare=true), 2026-09-30.
_pp_gate() {  # <PRE_PUSH_ONLY> <PRE_PUSH_SKIP_PASSED>
  ( cd "$top/csi-spl-iac" && env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_OBJECT_DIRECTORY \
      -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_QUARANTINE_PATH -u GIT_COMMON_DIR -u GIT_PREFIX \
      PRE_PUSH_ONLY="$1" PRE_PUSH_MODE="${SPL_PREPUSH_MODE:-fast}" PRE_PUSH_TIER="${SPL_PREPUSH_TIER:-fast}" \
      PRE_PUSH_LOG="$_pp_log" PRE_PUSH_CACHE="$_pp_log_dir/pre-push.parts.green" \
      PRE_PUSH_PASS="$_pp_log_dir/pre-push.tree.pass" PRE_PUSH_SKIP_PASSED="$2" ./run -a do_check_pre_push )
}

# Poisoned shared git config guard -- BEFORE trusting show-toplevel, because a
# core.worktree in the COMMON config points every worktree at ONE tree (measured:
# core.worktree=<one lane> made every lane's git read that lane's files), and it
# would otherwise pass every check below against the WRONG tree. A main checkout
# misdetected as bare breaks git here too. Under the override these skip the
# gate entirely (audited), so whoever is fixing the config can push the fix.
common="$(git rev-parse --git-common-dir 2>/dev/null)"
if [ "$_pp_override" = 1 ] && { { [ -n "$common" ] && git config -f "$common/config" --get core.worktree >/dev/null 2>&1; } \
     || [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" != true ]; }; then
  _pp_logline "OVERRIDE $PWD HEAD=$head remote=${1:-?} -- SPL_PREPUSH_OVERRIDE=1 on a broken git config, gate SKIPPED"
  echo "pre-push: SPL_PREPUSH_OVERRIDE=1 -- git config is broken here, deploy-gate SKIPPED (audited in $_pp_log)" >&2
  exit 0
fi
if [ -n "$common" ] && git config -f "$common/config" --get core.worktree >/dev/null 2>&1; then
  _pp_logline "REFUSE $PWD -- common git config has core.worktree (poisoned shared tree)"
  echo "pre-push: REFUSED -- the SHARED git config ($common/config) has core.worktree set; it points every worktree at one tree. Fix it ('git config -f $common/config --unset-all core.worktree') and tell the orchestrator. Override once with SPL_PREPUSH_OVERRIDE=1 only if you are the one fixing it." >&2
  exit 1
fi
if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" != true ]; then
  _pp_logline "REFUSE $PWD -- git does not see a work tree here (bare misdetection?)"
  echo "pre-push: REFUSED -- git does not resolve a working tree here (the shared config may have core.bare=true without the main worktree pinned false). Fix it and tell the orchestrator." >&2
  exit 1
fi

# Spec 102 section 5.4: a push whose remote refs are ALL refs/heads/wip/* (the
# watchdog's do_spl_lane_wip_push) is not gated: it carries unfinished work, CI
# does not build it, and the job must not block on the gate. Read from stdin,
# scoped to those refs only; a mixed push (wip + any other ref) is gated as usual.
_pp_wip=0
while read -r _ _ _pp_rref _; do
  [ -n "${_pp_rref:-}" ] || continue
  case "$_pp_rref" in refs/heads/wip/?*) _pp_wip=1 ;; *) _pp_wip=2; break ;; esac
done
if [ "$_pp_wip" = 1 ]; then
  _pp_logline "SKIP-WIP $PWD HEAD=$head remote=${1:-?} -- every ref is refs/heads/wip/*"
  echo "pre-push: every ref is refs/heads/wip/* -- the deploy-gate is skipped (spec 102 5.4)" >&2
  exit 0
fi

top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$top" ] || exit 0
run="$top/csi-spl-iac/run"

# Not the spool tree (or a checkout without the gate) -> let the push through.
if [ ! -x "$run" ]; then
  _pp_logline "SKIP not-the-spool-tree $top (no $run)"
  exit 0
fi

# Emergency override: the slow parts are skipped, the cheap correctness parts
# are not (seconds; their verdicts are cached like the full gate's).
if [ "$_pp_override" = 1 ]; then
  if _pp_gate override 0; then
    _pp_logline "OVERRIDE $top HEAD=$head remote=${1:-?} secs=$(_pp_secs) -- SPL_PREPUSH_OVERRIDE=1, slow parts SKIPPED, hygiene + lint-migration PASSED"
    echo "pre-push: SPL_PREPUSH_OVERRIDE=1 -- slow parts SKIPPED, hygiene + lint-migration passed (audited in $_pp_log)" >&2
    exit 0
  fi
  _pp_logline "REFUSE $top HEAD=$head secs=$(_pp_secs) -- SPL_PREPUSH_OVERRIDE=1, but hygiene/lint-migration FAILED"
  echo "pre-push: REFUSED -- SPL_PREPUSH_OVERRIDE=1 skips the slow parts, never hygiene or lint-migration, and one of them failed above. Fix it (a duplicate migration number: renumber yours past the head)." >&2
  exit 1
fi

# A tree the gate already passed WHOLE (the lane's own `./run -a
# do_check_pre_push` on this clean tree, same parts, tier, merge-base and gate
# code) is not re-run: the gate checks its tree-pass record first
# (PRE_PUSH_SKIP_PASSED=1, fleet-hot-commands 3.2) and logs PART tree
# PASS-tree. This replaced the hook's own pre-push.green stamp, which was keyed
# on the INDEX tree alone and also written by a pass that only WARNed a
# pre-existing red.
echo "pre-push: running the deploy-gate (do_check_pre_push, mode ${SPL_PREPUSH_MODE:-fast}, tier ${SPL_PREPUSH_TIER:-fast}). Override once with 'SPL_PREPUSH_OVERRIDE=1 git push …'." >&2
tree="$(git rev-parse -q --verify 'HEAD^{tree}' 2>/dev/null || echo '?')"
if _pp_gate "" 1; then
  _pp_logline "PASS $top HEAD=$head tree=$tree secs=$(_pp_secs)"
  exit 0
fi
_pp_logline "REFUSE $top HEAD=$head tree=$tree secs=$(_pp_secs) -- deploy-gate FAILED (the PART lines above say which)"
echo "pre-push: REFUSED -- the deploy-gate failed above. Fix it, or override once with 'SPL_PREPUSH_OVERRIDE=1 git push …' (audited in $_pp_log)." >&2
exit 1
