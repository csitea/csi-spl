# THE FOLLOWING VARIABLES ARE USED IN THE DOCKERFILE
# csi-spl ::: the csi-rel-orc src/docker/.env, reduced to what the tf infra stack
# (docker-compose-tf-infra.yaml: tf-runner, tpl-gen, conf-validator) reads.
# Named tf-infra.env, not .env: the repo .gitignore bans .env files outright,
# and csi-spl-orc/src/docker also holds the lde compose files.
# ORG_APP is the single source of truth for org and app.
# ORG and APP are derived by Makefile (lib/make/set-init-vars.mk) at build time.
# APP_PATH and ORG_DIR are NOT here: set-init-vars.mk derives them from the
# tree the Makefile runs in, so a worktree builds against itself.
ORG_APP=csi-spl
# THE OS USER AND GROUP THAT WILL BE USED IN THE DOCKER CONTAINER
APPUSR=appusr
APPGRP=appgrp
DOCKER_HOME=/home/appusr
DOCKER_SHELL=/bin/bash
# wheather or not to clone the config repo
SKIP_GIT_CLONE=0
# THE TERRAFORM VERESION IN USE (the image default; do_tf_init switches to
# csi-spl-cnf env.versions.terraform_version on every run)
TF_VERSION="1.9.8"
TF_SWITCH_VERSION=1.0.2
