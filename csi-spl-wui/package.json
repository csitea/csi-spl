{
  "name": "csi-spl-wui",
  "version": "1.1.3",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Spool WUI — Slack-like multi-channel interface (Nuxt 3 SSR + static generate for Firebase Hosting)",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "build": "nuxt build",
    "generate": "node src/node/blog/sync-blog.mjs && node src/node/roadmap/sync-roadmap.mjs && node src/node/docs/sync-public-docs.mjs && nuxt generate",
    "preview": "nuxt preview --host 0.0.0.0 --port 3000",
    "typecheck": "nuxt typecheck",
    "lint": "eslint --max-warnings 0 src",
    "postinstall": "nuxt prepare",
    "shims": "node src/node/generate-mjs-shims.mjs",
    "shims:check": "node src/node/generate-mjs-shims.mjs --check",
    "test:unit": "node src/node/test/run-unit-tests.mjs",
    "test": "node src/node/test/run-unit-tests.mjs",
    "test:e2e": "node src/node/test/run-e2e-tests.mjs",
    "test:live": "node --experimental-websocket tests/e2e/live-interop.test.mjs",
    "test:live:proofs": "node src/node/test/run-live-proofs.mjs"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@nuxtjs/i18n": "10.2.3",
    "@pinia/nuxt": "^0.11.3",
    "highlight.js": "~11.12.0",
    "markdown-it": "^15.0.3",
    "nuxt": "^3.16.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14",
    "@types/node": "^22.13.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10",
    "puppeteer-core": "^25.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8",
    "vue-eslint-parser": "^10",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "simple-git": "^4.0.2",
      "@simple-git/argv-parser": "^2.0.1",
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2",
      "vite": "^7.3.7",
      "launch-editor": "^2.14.2",
      "seroval": "~1.6.11",
      "node-forge": "^1.4.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-vjh5-4x84-xrqp",
        "GHSA-xfq5-w38q-pc2x",
        "GHSA-g3hv-75wg-m249",
        "GHSA-3g3m-2fjr-6pw4",
        "GHSA-648h-gw55-m2g7"
      ]
    }
  }
}
