{
  "name": "csi-spl-wui",
  "version": "1.1.3",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Spool WUI — Slack-like multi-channel interface (Nuxt 3 SSR + static generate for Firebase Hosting)",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "build": "nuxt build",
    "generate": "node src/node/blog/sync-blog.mjs && node src/node/roadmap/sync-roadmap.mjs && node src/node/docs/sync-public-docs.mjs && nuxt generate",
    "preview": "nuxt preview --host 0.0.0.0 --port 3000",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "test:unit": "node src/node/test/run-unit-tests.mjs",
    "test": "node src/node/test/run-unit-tests.mjs",
    "test:e2e": "node src/node/test/run-e2e-tests.mjs",
    "test:live": "node --experimental-websocket tests/e2e/live-interop.test.mjs"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@nuxtjs/i18n": "^9.5.6",
    "@pinia/nuxt": "^0.11.3",
    "highlight.js": "~11.11.0",
    "markdown-it": "^14",
    "nuxt": "^3.16.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14",
    "@types/node": "^22.13.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "simple-git": "^4.0.2",
      "@simple-git/argv-parser": "^2.0.1",
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
