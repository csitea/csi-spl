# wui.Dockerfile's context is the repo root (specs/047 W6: .git gives the
# version); send the builder only the WUI sources, .version and .git
*
!.version
!.git
!csi-spl-wui
csi-spl-wui/node_modules
csi-spl-wui/.nuxt
csi-spl-wui/.output
csi-spl-wui/.data
csi-spl-wui/.cache
csi-spl-wui/dist
csi-spl-wui/tests
csi-spl-wui/.pnpm-store
**/*.log
